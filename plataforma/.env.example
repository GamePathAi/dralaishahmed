# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# src/lib/env.ts valida tudo na inicializacao — a app nao sobe com campo faltando.
# ---------------------------------------------------------------------------

# --- Banco -----------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/dralais?schema=public&sslmode=require"

# --- Autenticacao ----------------------------------------------------------
AUTH_SECRET=""                      # gere com: npx auth secret
AUTH_URL="http://localhost:3000"

# --- E-mail (magic link do paciente) ---------------------------------------
# SMTP proprio ou servico transacional (Resend, SES, Postmark).
EMAIL_SERVER="smtp://usuario:senha@smtp.provedor.com:587"
EMAIL_FROM="contato@dralaishahmed.com.br"

# --- Cron de lembretes ------------------------------------------------------
# Autoriza POST /api/cron/lembretes. Gere com: openssl rand -base64 32
CRON_SECRET=""

# --- Anthropic (relatorio clinico) -----------------------------------------
# Solicite retencao zero (ZDR) a Anthropic antes de atender paciente real.
ANTHROPIC_API_KEY=""

# --- Daily.co (video WebRTC) -----------------------------------------------
DAILY_API_KEY=""
DAILY_DOMAIN=""                     # ex.: dralais.daily.co

# --- AWS (audio temporario + transcricao) ----------------------------------
# Bucket PRIVADO e dedicado, com regra de ciclo de vida expirando em 1 dia.
# A Amazon Transcribe le o audio deste bucket e grava o JSON do resultado nele.
# O IAM precisa de: s3:PutObject/GetObject/DeleteObject no bucket, e
# transcribe:StartTranscriptionJob/GetTranscriptionJob/CreateVocabulary/
# GetVocabulary/UpdateVocabulary.
AWS_REGION="sa-east-1"
AWS_S3_BUCKET_AUDIO=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Identificacao profissional --------------------------------------------
CRM_MEDICA="CRM-MS 16563"
NOME_MEDICA="Dra. Laís Caroline Hahmed"
